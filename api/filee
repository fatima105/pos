const sqlite3 = require("sqlite3").verbose();
const path = require("path");

const dbPath = path.join(__dirname, "alimart.db");
const db = new sqlite3.Database(dbPath, (err) => {
  if (err) {
    console.error("❌ Error connecting to SQLite:", err.message);
  } else {
    console.log("✅ Connected to ALiMart SQLite database:", dbPath);
  }
});

// List of tables to KEEP
const keepTables = ["chart_of_accounts","Product","Category", "Product","customer","SubCategory", "Unit", "Supplier"];

// Drop all other tables
db.serialize(() => {
  db.all(
    `SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';`,
    (err, tables) => {
      if (err) {
        console.error("❌ Error fetching table names:", err.message);
        return;
      }

      if (!tables || tables.length === 0) {
        console.log("⚠️ No tables found in database.");
        return;
      }

      tables.forEach((table) => {
        const tableName = table.name;
        if (!keepTables.includes(tableName)) {
          db.run(`DROP TABLE IF EXISTS "${tableName}"`, (err) => {
            if (err) {
              console.error(`❌ Error dropping ${tableName}:`, err.message);
            } else {
              console.log(`🗑️ Dropped table: ${tableName}`);
            }
          });
        } else {
          console.log(`✅ Kept table: ${tableName}`);
        }
      });
    }
  );
});
// Drop only Supplier table


module.exports = db;



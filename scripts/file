    <link href="scripts/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="scripts/style.css" />
  </head>
  <body>
    <div class="main-container">
      <div id="sidebar-container"></div>
      <div class="content-container">
        <div class="container-fluid bg-gray">
          <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Edit Product</h4>
            <nav aria-label="breadcrumb">
              <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                  <a href="index.html" class="text-primary text-decoration-none">Home</a>
                </li>
                <li class="breadcrumb-item">
                  <a href="products.html" class="text-primary text-decoration-none">Product</a>
                </li>
                <li class="breadcrumb-item active text-muted" aria-current="page">
                  Edit
                </li>
              </ol>
            </nav>
          </div>

          <div id="alertPlaceholder" class="position-fixed top-0 start-50 translate-middle-x mt-4" style="z-index: 1055; width: 400px; max-width: 90%;"></div>

          <div style="margin-top:10px;" class="d-flex justify-content-center">
            <div class="card py-3 px-3 shadow-lg bg-white" style="width: 80%; max-width: 500px">
              <form id="ProductUpdate">
                <input id="ProductId" value="" type="hidden" />
                <div class="mb-3">
                  <label class="form-label fw-bold">Product Name <span class="text-danger">*</span></label>
                  <input id="name" type="text" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Retail Price <span class="text-danger">*</span></label>
                  <input id="retail_price" type="text" class="form-control" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Parent Category <span class="text-danger">*</span></label>
                  <select id="category_id" class="form-select"></select>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Sub Category <span class="text-danger">*</span></label>
                  <select id="sub_category_id" class="form-select"></select>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Product Unit <span class="text-danger">*</span></label>
                  <select id="unit_id" class="form-select"></select>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">SKU <span class="text-danger">*</span></label>
                  <input id="SKU" type="text" readonly class="form-control" required />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Product Description <span class="text-danger">*</span></label>
                  <textarea id="description" rows="4" class="form-control" required></textarea>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Tax <span class="text-danger">*</span></label>
                  <select id="tax" class="form-select">
                    <option>Inclusive Tax</option>
                    <option>Exclusive Tax</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-bold">Status <span class="text-danger">*</span></label>
                  <select id="status" class="form-select">
                    <option>Active</option>
                    <option>Block</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label">Selected Category:</label>
                  <div id="current_category_display" class="form-control bg-light"></div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Selected Subcategory:</label>
                  <div id="current_subcategory_display" class="form-control bg-light"></div>
                </div>

                <div class="mb-3">
                  <label class="form-label">Selected Unit:</label>
                  <div id="current_unit_display" class="form-control bg-light"></div>
                </div>

                <button type="submit" class="btn btn-primary">Submit</button>
              </form>
